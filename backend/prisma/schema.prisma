generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  CUSTOMER
  MITRA
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHOPPING
  READY_TO_DELIVER
  ON_DELIVERY
  DELIVERED
  CANCELLED
  WAITING_QUOTE
  WAITING_APPROVAL
}

enum OrderType {
  PRODUCT
  CUSTOM_JASTIP
}

enum PaymentMethod {
  COD
  QRIS
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  ON_DELIVERY
  DELIVERED
  FAILED
}

// ─── Users ───────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String?    @unique
  phone        String     @unique
  name         String
  password     String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders       Order[]
  addresses    Address[]
  mitraProfile MitraProfile?

  @@map("users")
}

model MitraProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  isOnline      Boolean  @default(false)
  area          String?
  vehicleType   String?
  vehicleNumber String?
  rating        Float    @default(0)
  totalOrders   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  deliveries    Delivery[]

  @@map("mitra_profiles")
}

// ─── Addresses ───────────────────────────────────────────

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  label         String
  recipientName String
  phone         String
  address       String
  latitude      Float?
  longitude     Float?
  note          String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]

  @@map("addresses")
}

// ─── Stores ──────────────────────────────────────────────

model Store {
  id          String    @id @default(uuid())
  name        String
  description String
  address     String
  latitude    Float?
  longitude   Float?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("stores")
}

// ─── Categories ──────────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  name      String
  image     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@map("categories")
}

// ─── Products ─────────────────────────────────────────────

model Product {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  name        String
  description String
  price       Float
  image       String?
  stock       Int       @default(0)
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems  OrderItem[]

  @@map("products")
}

// ─── Orders ──────────────────────────────────────────────

model Order {
  id           String        @id @default(uuid())
  orderNumber  String        @unique
  customerId   String
  customer     User          @relation(fields: [customerId], references: [id])
  mitraId      String?
  mitra        MitraProfile? @relation(fields: [mitraId], references: [id])
  addressId    String?
  address      Address?      @relation(fields: [addressId], references: [id])
  orderType    OrderType     @default(PRODUCT)
  status       OrderStatus   @default(PENDING)
  subtotal     Float
  serviceFee   Float         @default(5000)
  deliveryFee  Float         @default(8000)
  discount     Float         @default(0)
  total        Float
  customerNote String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items        OrderItem[]
  payment      Payment?
  delivery     Delivery?

  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  productName    String
  qty            Int
  estimatedPrice Float
  actualPrice    Float?
  subtotal       Float
  note           String?

  @@map("order_items")
}

// ─── Payments ─────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethod @default(COD)
  amount        Float
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@map("payments")
}

// ─── Deliveries ───────────────────────────────────────────

model Delivery {
  id             String         @id @default(uuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  mitraId        String?
  mitra          MitraProfile?  @relation(fields: [mitraId], references: [id])
  status         DeliveryStatus @default(PENDING)
  pickupLat      Float?
  pickupLng      Float?
  destinationLat Float?
  destinationLng Float?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("deliveries")
}

// ─── Areas ────────────────────────────────────────────────

model Area {
  id          String   @id @default(uuid())
  name        String
  description String?
  baseFee     Float
  maxDistance Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("areas")
}
